# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# TURSO SQLITE DATABASE SETTINGS
# Obtain Database URL and Auth Token after signing in with GitHub at https://turso.tech
TURSO_DATABASE_URL="libsql://marso-db-yourusername.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# CLOUDFLARE R2 PHOTO & ASSET STORAGE SETTINGS
# Obtain Account ID, R2 API Token, Bucket Name, and Public URL at https://dash.cloudflare.com
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="marso-photos"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# ADMIN AUTHENTICATION
ADMIN_PASSWORD="marso_admin_2026"
