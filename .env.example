# ==============================================================================
# MARSO RUBBER PRODUCT SPECIALIST — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Secret key used for signing & verifying admin session HMAC tokens (min 32 characters).
SESSION_SECRET="GENERATE_A_LONG_RANDOM_SECRET_MIN_32_CHARS"

# Administrator password required for login to /admin portal (min 8 characters).
ADMIN_PASSWORD="SET_A_STRONG_ADMIN_PASSWORD"

# Secret key used for signing & validating datasheet access codes (min 32 characters).
ACCESS_CODE_SECRET="GENERATE_A_LONG_RANDOM_SECRET_MIN_32_CHARS"

# Comma-separated list of allowed CORS origins in production (no trailing slashes).
# Example: ALLOWED_ORIGINS=https://marso-rubber-guide.vercel.app
ALLOWED_ORIGINS="https://your-domain.vercel.app"

# ------------------------------------------------------------------------------
# 2. GEMINI AI CONSULTANT & SPEC EXTRACTION
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls. Obtain at https://aistudio.google.com
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ------------------------------------------------------------------------------
# 3. TURSO SQLITE DATABASE (PERSISTENT DATA STORE)
# ------------------------------------------------------------------------------
# Obtain Database URL and Auth Token after signing in at https://turso.tech
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (ASSETS & DATASHEETS)
# ------------------------------------------------------------------------------
# Obtain Account ID, R2 API Token, Bucket Name, and Public URL at https://dash.cloudflare.com
R2_ACCOUNT_ID="YOUR_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="marso-photos"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
