# ==============================================================================
# MARSO RUBBER PRODUCT SPECIALIST — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Secret key used for signing & verifying admin session HMAC tokens.
SESSION_SECRET="your_secure_session_secret_key_here_min_32_chars"

# Administrator password required for login to /admin portal.
ADMIN_PASSWORD="your_strong_admin_password_here"

# Secret key used for signing & validating 4-digit datasheet access codes.
ACCESS_CODE_SECRET="your_access_code_secret_key_here_min_32_chars"

# Comma-separated list of allowed CORS origins in production (no trailing slashes).
# Example: ALLOWED_ORIGINS=https://marso-rubber-guide.vercel.app,https://www.marso-egy.com
ALLOWED_ORIGINS="https://marso-rubber-guide.vercel.app"

# ------------------------------------------------------------------------------
# 2. GEMINI AI CONSULTANT & SPEC EXTRACTION
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls. Obtain at https://aistudio.google.com
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ------------------------------------------------------------------------------
# 3. TURSO SQLITE DATABASE (PERSISTENT DATA STORE)
# ------------------------------------------------------------------------------
# Obtain Database URL and Auth Token after signing in with GitHub at https://turso.tech
TURSO_DATABASE_URL="libsql://marso-db-yourusername.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (ASSETS & DATASHEETS)
# ------------------------------------------------------------------------------
# Obtain Account ID, R2 API Token, Bucket Name, and Public URL at https://dash.cloudflare.com
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="marso-photos"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
